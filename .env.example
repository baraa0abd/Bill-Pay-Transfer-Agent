DATABASE_URL=sqlite:///wallet.db
LLM_PROVIDER=rule
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Free hosted options (see the challenge's LLM access guide): LLM_PROVIDER=groq or gemini
GROQ_API_KEY=
